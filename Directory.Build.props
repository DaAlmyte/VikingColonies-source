<Project>
  <PropertyGroup>
    <ValheimDir Condition="'$(ValheimDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Valheim</ValheimDir>
    <ProfileDir Condition="'$(ProfileDir)' == ''">$(APPDATA)\r2modmanPlus-local\Valheim\profiles\ColonyDev</ProfileDir>
    <ManagedDir>$(ValheimDir)\valheim_Data\Managed</ManagedDir>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <!-- No folder of the PC that built it in a DLL (the security sweep of 27 Oct 2026: its debug entry held the Windows account's name) -->
    <PathMap>$(MSBuildThisFileDirectory)=/VikingColonies/</PathMap>
  </PropertyGroup>
</Project>
